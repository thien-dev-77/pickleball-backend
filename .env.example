PORT=8001
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-ENCODED-PASSWORD@YOUR-SESSION-POOLER.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_HOURS=12
ADMIN_SESSION_TOUCH_MINUTES=5
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage credentials belong only on the backend, never in NEXT_PUBLIC_*.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role keys are also supported as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_STORAGE_BUCKET=pickleball-images
